{
  "expo": {
    "name": "WorldPass",
    "slug": "worldpass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worldpass.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "WorldPass needs camera access to scan QR codes for credentials",
        "NSFaceIDUsageDescription": "WorldPass uses Face ID to secure your wallet"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.worldpass.mobile",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WorldPass to access your camera to scan QR codes"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow WorldPass to use Face ID to secure your wallet"
        }
      ],
      "expo-font"
    ]
  }
}
